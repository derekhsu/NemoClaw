# Hermes tools image for OpenShell 0.1.x (issue #74): extends a published
# Hermes image with the document, PDF/OCR, media, browser, and workspace tools
# of the OpenClaw tools image (the repository-root Dockerfile.tools). Fork-only.
#
# The package lists and fixtures live in tools/openclaw-tools-image/ and are
# shared with the root Dockerfile.tools. This file differs from it only where Hermes
# differs from OpenClaw:
# - The Python packages go into the system interpreter, /usr/bin/python3.
#   The image PATH puts the Hermes virtual environment first, so a plain
#   python3 is Hermes' own interpreter, which these packages must not change.
# - No OpenClaw skill or openclaw.json change. The Hermes browser tools use
#   the base image's agent-browser: config.yaml, the managed policy, and the
#   Hermes default for named profiles set browser.backend "off", and
#   /etc/chromium.d/nemoclaw-openshell adds the Chromium flags that an
#   OpenShell sandbox requires.
#
# The final image keeps the base image's user, entrypoint, command, working
# directory, environment, healthcheck, and controlled package versions. It
# ships no compiler.

# Tag and index digest of the published Hermes image. The release tag of this
# image is <tag>-tools.<n>.
ARG BASE_IMAGE=docker.io/derekhsu/openshell-hermes:openshell01x-hermes-0.21.3-2026.11.13@sha256:1b0f2030fec36118c9124c0f28a5e435f61bfb4f502f39e942e365873e8c8265

# Downloaded single-file tools, verified by checksum. The final stage
# installs the file for its own architecture through a bind mount, so the
# other architecture's file never enters an image layer.
FROM scratch AS downloads
ADD --checksum=sha256:baa084b64ec634bd9d41a0592db3ed85f11658b358bab898679537ea7f3e73a9 \
    https://github.com/iOfficeAI/OfficeCLI/releases/download/v1.0.160/officecli-linux-x64 /officecli-amd64
ADD --checksum=sha256:e8f06aff6c59f11a73a1a1218bda3ce170299201fd56bce6d62ecd4d0c024e53 \
    https://github.com/iOfficeAI/OfficeCLI/releases/download/v1.0.160/officecli-linux-arm64 /officecli-arm64
# Chrome Headless Shell revision 1248 is the default browser of Playwright 1.64.1.
ADD --checksum=sha256:c3e50596aef52c58f8fda3c6b3411c33d34c88b177b3ed1c2243359fd3b8ba20 \
    https://cdn.playwright.dev/builds/cft/156.0.8078.4/linux64/chrome-headless-shell-linux64.zip /chrome-headless-shell-amd64.zip
ADD --checksum=sha256:81ab9d4d3c301dc5fdfb6c541b9e6632b16fc819a6a854460f40a76fe2b2c476 \
    https://cdn.playwright.dev/builds/cft/156.0.8078.4/linux-arm64/chrome-headless-shell-linux-arm64.zip /chrome-headless-shell-arm64.zip
ADD --checksum=sha256:ca362a16f2e1c3cfa81d406f3242446179a0e4aea457ba3e9e6c39e6476aba65 \
    https://registry.npmjs.org/pnpm/-/pnpm-12.16.1.tgz /pnpm-12.16.1.tgz
ADD --checksum=sha256:bb7f8f14b9ce2e2344ff5cd6c06f2e105eb99541ecbfec77139e2886d9c0b9ba \
    https://cdnjs.cloudflare.com/ajax/libs/p5.js/1.7.0/p5.min.js /p5.min.js
# Himalaya v2.2.1 release archives: a static-pie binary plus completions and
# man pages. Brew installs the same release.
ADD --checksum=sha256:5c5ba2724c162f82d0a0c71b6c03224ed44f8bef7b14ace5da0635d3af2665a0 \
    https://github.com/pimalaya/himalaya/releases/download/v2.2.1/himalaya.x86_64-linux.tgz /himalaya-amd64.tgz
ADD --checksum=sha256:1dc21c3dd6d948929e22e5cae49b9d0b3b30ff88fafd4493fd4460c6252e9d90 \
    https://github.com/pimalaya/himalaya/releases/download/v2.2.1/himalaya.aarch64-linux.tgz /himalaya-arm64.tgz

# The yq 4.54.1 release binaries use Go 1.27.1 and golang.org/x/net 0.59.0,
# which have HIGH vulnerabilities with available fixes. Build the same yq version with a
# patched Go toolchain and x/net. Go verifies module hashes with sumdb.
FROM golang:1.27.4-trixie@sha256:f18c3d73a184fb0582828510722e723b63a93f7188d11dd223d9be6f6880e65d AS yq-build
ENV CGO_ENABLED=0 GOTOOLCHAIN=local GOFLAGS=-trimpath
WORKDIR /src
RUN set -eu; \
    go mod init nemoclaw-tools/yq; \
    go get github.com/mikefarah/yq/v4@v4.54.1 golang.org/x/net@v0.62.0; \
    go build -ldflags='-s -w' -o /out/yq github.com/mikefarah/yq/v4; \
    /out/yq --version

# LibreOffice Calc reaches libtext-charwidth-perl through ucf. Debian builds
# it for Perl 5.40, but the base carries the controlled Perl 5.44. Rebuild
# the module for Perl 5.44 here so the compiler stays out of the final image.
# Debian 0.04-11 has no source patches; match its hardening flags.
FROM ${BASE_IMAGE} AS perl-modules
# hadolint ignore=DL3002,DL3066
USER root
ADD --checksum=sha256:abded5f4fdd9338e89fd2f1d8271c44989dae5bf50aece41b6179d8e230704f8 \
    https://cpan.metacpan.org/authors/id/K/KU/KUBOTA/Text-CharWidth-0.04.tar.gz /tmp/Text-CharWidth-0.04.tar.gz
# hadolint ignore=DL3003,DL3008
RUN set -eu; \
    while IFS='=' read -r pkg _; do \
        [ "$pkg" = architecture ] || apt-mark hold "$pkg" >/dev/null; \
    done </usr/local/share/nemoclaw/security-packages.txt; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends gcc make libc6-dev dpkg-dev; \
    mkdir -p /tmp/charwidth /tmp/stage/DEBIAN /out; \
    tar -xzf /tmp/Text-CharWidth-0.04.tar.gz --strip-components=1 -C /tmp/charwidth; \
    cd /tmp/charwidth; \
    eval "$(DEB_BUILD_MAINT_OPTIONS=hardening=+all dpkg-buildflags --export=sh)"; \
    perl Makefile.PL INSTALLDIRS=vendor OPTIMIZE="$CFLAGS $CPPFLAGS" LDDLFLAGS="-shared $LDFLAGS"; \
    make; \
    make test; \
    make pure_install DESTDIR=/tmp/stage; \
    find /tmp/stage -name .packlist -delete; \
    printf '%s\n' \
        'Package: libtext-charwidth-perl' \
        'Version: 0.04-11+nemoclaw1' \
        "Architecture: $(dpkg --print-architecture)" \
        'Multi-Arch: same' \
        'Depends: libc6, perl-base (= 5.44.0-1nemoclaw1)' \
        'Maintainer: derekhsu/NemoClaw fork' \
        'Description: Text::CharWidth rebuilt for the controlled Perl 5.44' \
        >/tmp/stage/DEBIAN/control; \
    dpkg-deb --build --root-owner-group /tmp/stage /out/libtext-charwidth-perl.deb

FROM ${BASE_IMAGE}
# hadolint ignore=DL3066
USER root

# Docker's overlay2 storage driver refuses an image with more than 125 layers
# (#70). Copy every build input first and keep the steps below in three RUN
# instructions so this stage adds 8 layers.
COPY --from=perl-modules /out/libtext-charwidth-perl.deb /tmp/nemoclaw-tools/
COPY tools/openclaw-tools-image/apt-packages.txt tools/openclaw-tools-image/apt-packages-browser.txt \
    tools/openclaw-tools-image/python/requirements.lock \
    agents/hermes-01x/configure-tools-browser.py agents/hermes-01x/image-build-probes.py \
    /tmp/nemoclaw-tools/
COPY --from=yq-build --chmod=0755 /out/yq /usr/local/bin/yq
COPY tools/openclaw-tools-image/node/package.json tools/openclaw-tools-image/node/package-lock.json \
    /usr/local/lib/nemoclaw-tools-node/
COPY tools/openclaw-tools-image/frontend-template/ /usr/local/share/nemoclaw-tools/frontend-template/

# The package lists pin every version; hadolint cannot read them.
# hadolint ignore=SC2046,DL3003,DL3008
RUN set -eu; \
    # System packages. Hold every controlled package so apt fails instead of
    # changing one, then confirm the versions after installation.
    inventory=/usr/local/share/nemoclaw/security-packages.txt; \
    while IFS='=' read -r pkg version; do \
        [ "$pkg" = architecture ] && continue; \
        test "$(dpkg-query -W -f='${Version}' "$pkg")" = "$version"; \
        apt-mark hold "$pkg" >/dev/null; \
    done <"$inventory"; \
    apt-get update; \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        /tmp/nemoclaw-tools/libtext-charwidth-perl.deb \
        $(grep -hEv '^(#|$)' /tmp/nemoclaw-tools/apt-packages.txt /tmp/nemoclaw-tools/apt-packages-browser.txt); \
    while IFS='=' read -r pkg version; do \
        [ "$pkg" = architecture ] && continue; \
        test "$(dpkg-query -W -f='${Version}' "$pkg")" = "$version" \
            || { echo "controlled package changed: $pkg" >&2; exit 1; }; \
    done <"$inventory"; \
    apt-mark unhold $(apt-mark showhold) >/dev/null; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/*; \
    # The sandbox policy allows reads under /usr but not /var/cache. Build the
    # fontconfig cache in its default location, copy it under /usr, and list
    # that copy as a read-only cache directory so processes do not rebuild it.
    # fontconfig rejects a cache when a font directory's mtime differs, down to
    # nanoseconds. BuildKit's layer export drops the nanoseconds and also drops
    # a layer change that only touches a directory's mtime. Truncate each mtime
    # to its own whole second, the value the exported image has either way.
    # Follow symlinks: /usr/share/fonts/cmap links to directories elsewhere.
    for root in /usr/share/fonts /usr/local/share/fonts; do \
        if [ -d "$root" ]; then \
            find -L "$root" -type d -exec sh -c 'for d; do touch -m -d "@$(stat -L -c %Y "$d")" "$d"; done' sh {} +; \
        fi; \
    done; \
    fc-cache -f; \
    install -d -m 0755 /usr/local/share/nemoclaw-tools/fontconfig-cache; \
    cp -a /var/cache/fontconfig/. /usr/local/share/nemoclaw-tools/fontconfig-cache/; \
    ls /usr/local/share/nemoclaw-tools/fontconfig-cache/*.cache-* >/dev/null; \
    printf '%s\n' \
        '<?xml version="1.0"?>' \
        '<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">' \
        '<fontconfig>' \
        '  <cachedir>/usr/local/share/nemoclaw-tools/fontconfig-cache</cachedir>' \
        '</fontconfig>' \
        >/etc/fonts/conf.d/99-nemoclaw-tools-cachedir.conf; \
    # Python packages go into the system interpreter. Name it by path: the
    # image PATH resolves python3 to the Hermes virtual environment.
    PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 /usr/bin/python3 -m pip install \
        --break-system-packages --require-hashes --only-binary :all: \
        --no-warn-script-location -r /tmp/nemoclaw-tools/requirements.lock; \
    /usr/bin/python3 -m pip check; \
    # Node.js document libraries. /usr/local/lib/node is a Node.js global
    # folder, so require() resolves from any directory. The /sandbox link lets
    # ESM imports resolve from the agent workspace.
    ( cd /usr/local/lib/nemoclaw-tools-node \
      && NPM_CONFIG_OFFLINE=false npm ci --omit=dev --no-audit --no-fund \
      && npm cache clean --force ); \
    ln -s /usr/local/lib/nemoclaw-tools-node/node_modules /usr/local/lib/node; \
    ln -s /usr/local/lib/nemoclaw-tools-node/node_modules /sandbox/node_modules; \
    chown -h sandbox:sandbox /sandbox/node_modules

RUN --mount=type=bind,from=downloads,target=/downloads \
    set -eu; \
    arch=$(dpkg --print-architecture); \
    install -m 0755 "/downloads/officecli-$arch" /usr/local/bin/officecli; \
    mkdir /tmp/himalaya; \
    tar -xzf "/downloads/himalaya-$arch.tgz" -C /tmp/himalaya himalaya share/completions/himalaya.bash share/man; \
    install -m 0755 /tmp/himalaya/himalaya /usr/local/bin/himalaya; \
    install -D -m 0644 /tmp/himalaya/share/completions/himalaya.bash /usr/share/bash-completion/completions/himalaya; \
    install -d -m 0755 /usr/local/share/man/man1; \
    install -m 0644 /tmp/himalaya/share/man/*.1.gz /usr/local/share/man/man1/; \
    rm -rf /tmp/himalaya; \
    case "$(/usr/local/bin/himalaya --version)" in "himalaya v2.2.1 "*) ;; *) exit 1 ;; esac; \
    # Playwright looks for its browsers in $HOME/.cache/ms-playwright, and the
    # sandbox user's home is /sandbox. Install the pinned headless shell under
    # /usr and link it there, like /sandbox/node_modules.
    browsers=/usr/local/share/nemoclaw-tools/ms-playwright; \
    install -d -m 0755 "$browsers/chromium_headless_shell-1248"; \
    unzip -q "/downloads/chrome-headless-shell-$arch.zip" -d "$browsers/chromium_headless_shell-1248"; \
    touch "$browsers/chromium_headless_shell-1248/INSTALLATION_COMPLETE"; \
    install -d -o sandbox -g sandbox /sandbox/.cache; \
    ln -s "$browsers" /sandbox/.cache/ms-playwright; \
    chown -h sandbox:sandbox /sandbox/.cache/ms-playwright; \
    install -D -m 0644 /downloads/p5.min.js /usr/local/share/nemoclaw-tools/p5/p5.min.js; \
    NPM_CONFIG_OFFLINE=false npm install -g --no-audit --no-fund /downloads/pnpm-12.16.1.tgz

# The printf and python -c arguments are literal text, not shell expansions.
# The only pipe ends in sha256sum -c, whose status is the pipe status.
# hadolint ignore=DL3003,DL4006,SC2016
RUN set -eu; \
    # Offline frontend projects start from a copy of this template. pnpm's
    # store keeps a SQLite index that cannot be opened from a read-only path,
    # so the template ships with node_modules installed and no store. Copying
    # it with `cp -a` keeps pnpm's relative links working.
    ( cd /usr/local/share/nemoclaw-tools/frontend-template \
      && pnpm install --frozen-lockfile --store-dir /tmp/nemoclaw-tools/pnpm-store \
      && pnpm run build \
      && rm -rf dist /tmp/nemoclaw-tools/pnpm-store ); \
    chmod -R a+rX /usr/local/share/nemoclaw-tools/frontend-template; \
    # The Hermes browser tool runs the base image's agent-browser, which starts
    # /usr/bin/chromium. That Debian wrapper reads its flags from
    # /etc/chromium.d before it runs /usr/lib/chromium/chromium. OpenShell's
    # seccomp refuses the user namespaces of Chromium's own sandbox and
    # zygote, so Chromium needs --no-sandbox and --no-zygote there (#27). The
    # OpenShell sandbox (seccomp, Landlock, network policy) still isolates the
    # browser. Hermes adds --no-sandbox itself only under root or Docker.
    test -x /usr/lib/chromium/chromium; \
    printf '%s\n' \
        '# OpenShell sandbox flags; see agents/hermes-01x/Dockerfile.tools (#74).' \
        'export CHROMIUM_FLAGS="$CHROMIUM_FLAGS --no-sandbox --no-zygote --disable-gpu"' \
        >/etc/chromium.d/nemoclaw-openshell; \
    chmod 0644 /etc/chromium.d/nemoclaw-openshell; \
    # Keep Hermes on its built-in browser tools instead of the Browser Use CLI
    # that `uvx browser-use` fetches from PyPI (configure-tools-browser.py
    # explains why). The managed policy gets the same value, or the dashboard
    # config seeder refuses the gateway config (#79). Named profiles have no
    # config.yaml, so the script also changes the browser.backend default in
    # two Hermes source files (#83). The hashes below are those files in
    # BASE_IMAGE: check the script's edits against a new base image before
    # changing them. Then seal config.yaml again exactly as the base image
    # does; only the config.yaml hash line changes.
    config=/sandbox/.hermes/config.yaml; \
    policy=/usr/local/share/nemoclaw/hermes-managed-policy.json; \
    seal=/etc/nemoclaw/hermes.config-hash; \
    test "$(stat -c '%U:%G %a' "$config")" = "sandbox:sandbox 640"; \
    test "$(stat -c '%U:%G %a' "$policy")" = "root:root 444"; \
    test "$(stat -c '%U:%G %a' "$seal")" = "root:root 444"; \
    sha256sum -c --quiet "$seal"; \
    mcp_line=$(grep '^# nemoclaw-hermes-mcp-state-v1 ' "$seal"); \
    printf '%s  %s\n' \
        d990eecd35d5b3447ca6f81ba1c6618d0702e2d4281b932974a5e64b29d8436b /opt/hermes/tools/browser_use_cli.py \
        13e4261f6b47269b92c9cf0f13eac385c8c070a96190d4177639eea239d21def /opt/hermes/hermes_cli/config_defaults.py \
        | sha256sum -c --quiet -; \
    /usr/bin/python3 -I /tmp/nemoclaw-tools/configure-tools-browser.py "$config" "$policy" /opt/hermes; \
    test "$(stat -c '%U:%G %a' "$policy")" = "root:root 444"; \
    # Replace the base image's bytecode of the two changed modules, so Hermes
    # does not compile them on every start.
    /opt/hermes/.venv/bin/python -I -m py_compile \
        /opt/hermes/tools/browser_use_cli.py /opt/hermes/hermes_cli/config_defaults.py; \
    ( cd /opt/hermes && HERMES_HOME=/sandbox/.hermes /opt/hermes/.venv/bin/python -I -c \
        'import sys; sys.path.insert(0, "/opt/hermes"); from tools.browser_use_cli import get_browser_backend, is_browser_use_cli_mode; assert get_browser_backend() == "off" and not is_browser_use_cli_mode()' ); \
    mcp_digest="$(/opt/hermes/.venv/bin/python -I /usr/local/lib/nemoclaw/build-hermes-mcp-digest.py --guard /usr/local/lib/nemoclaw/hermes-runtime-config-guard.py --config "$config")"; \
    test "$mcp_line" = "# nemoclaw-hermes-mcp-state-v1 intended=$mcp_digest applied=$mcp_digest"; \
    chmod 0644 "$seal"; \
    sha256sum "$config" /sandbox/.hermes/.env >"$seal"; \
    printf '%s\n' "$mcp_line" >>"$seal"; \
    chmod 0444 "$seal"; \
    cp "$seal" /sandbox/.hermes/.config-hash; \
    chown sandbox:sandbox /sandbox/.hermes/.config-hash; \
    chmod 0640 /sandbox/.hermes/.config-hash; \
    sha256sum -c --quiet "$seal"; \
    # Repeat the base image's dashboard policy probe on the changed files, as
    # the sandbox user: the seeder must accept the gateway config and copy the
    # model and every managed path, browser.backend included.
    probe=/tmp/nemoclaw-dashboard-policy-probe.yaml; \
    setpriv --reuid=sandbox --regid=sandbox --init-groups \
        /opt/hermes/.venv/bin/python -I /usr/local/lib/nemoclaw/seed-hermes-dashboard-config.py \
        "$policy" "$config" "$probe"; \
    grep -q '^model:' "$probe"; \
    setpriv --reuid=sandbox --regid=sandbox --init-groups \
        /opt/hermes/.venv/bin/python -I /tmp/nemoclaw-tools/image-build-probes.py dashboard-policy "$probe"; \
    test ! -e "$probe"; \
    # Repeat the base image's profile-policy probe on a new named profile,
    # which has no config.yaml. It compares every managed path, browser.backend
    # included. get_browser_backend() must also return "off" for the named
    # profile, so Hermes does not use the Browser Use CLI.
    profile_root=$(mktemp -d); \
    HOME="$profile_root" HERMES_HOME="$profile_root/.hermes" \
        /usr/local/bin/hermes profile create nemoclaw-policy-probe --no-alias --no-skills; \
    profile_home="$profile_root/.hermes/profiles/nemoclaw-policy-probe"; \
    test ! -e "$profile_home/config.yaml"; \
    HOME="$profile_root" HERMES_HOME="$profile_home" \
        /opt/hermes/.venv/bin/python -I /tmp/nemoclaw-tools/image-build-probes.py profile-policy; \
    ( cd /opt/hermes && HOME="$profile_root" HERMES_HOME="$profile_home" /opt/hermes/.venv/bin/python -I -c \
        'import sys; sys.path.insert(0, "/opt/hermes"); from tools.browser_use_cli import get_browser_backend, is_browser_use_cli_mode; assert get_browser_backend() == "off" and not is_browser_use_cli_mode()' ); \
    rm -rf "$profile_root"; \
    rm -rf /tmp/nemoclaw-tools /root/.npm /root/.cache /root/.local/share/pnpm

# Same user name as the base image configuration.
# hadolint ignore=DL3066
USER sandbox
